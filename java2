package alquilar;

/**
*/
public  class Auto extends Vehiculo {
    public Auto(String marca,String modelo,double tarifabase){
    super(marca,modelo,tarifabase);}

    @Override
    public double calcularcostodealquiler(int dias) {
        return (getTarifabase()+ 10) *dias;
    }
    
}
